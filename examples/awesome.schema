datasource db {
  provider = "surrealdb"
  url      = env("SURREALDB_URL")
  namespace = "app"
  database  = "main"
}

naming {
  tables = "snake_case"
}

generator client {
  provider = "typescript"
  output   = "./generated"
}

type UserMetadata @flexible {
  user_id int?
  source  string
}

model User {
  id        @id
  email     string @unique
  name      string
  age       int?
  profile   object?
  metadata  object @flexible {
    user_id int?
    source  string
  }
  settings  UserMetadata
  tags      string[]
  createdAt datetime @value(time::now()) @readonly
  updatedAt datetime @updated(time::now())

  posts     Post[] @link("PostAuthor")
  liked     Post[] @relation("Likes")

  @@table(schemafull)
  @@permissions("FULL")
}

model Post {
  id        @id
  title     string
  content   string
  author    User @link("PostAuthor") @onDelete(Cascade)
  createdAt datetime @value(time::now()) @readonly
  updatedAt datetime @updated(time::now())

  @@table(schemafull)
  @@index([title])
}

edge Likes {
  in  User
  out Post

  createdAt datetime @value(time::now()) @readonly
  updatedAt datetime @updated(time::now())

  @@table(schemafull)
}

model TestTable {
  id        @id
  test      string

  testObject object
}
